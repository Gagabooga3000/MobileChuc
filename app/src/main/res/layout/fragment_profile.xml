<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_background_height"
        android:background="@drawable/header_background" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="@dimen/header_section_top_padding"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/student_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/header_card_top_margin"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/bg_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/header_card_min_height"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:gravity="bottom">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginEnd="16dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/student_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/pupu"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CircleImage"
                            app:strokeColor="@color/brand_primary"
                            app:strokeWidth="3dp" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="6dp"
                            android:background="@drawable/circle_background"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="@color/brand_primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/student_name"
                            style="@style/TextAppearance.Chuc.Title"
                            android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                            android:text="Иванов Иван Иванович" />

                        <TextView
                            android:id="@+id/student_group"
                            style="@style/TextAppearance.Chuc.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Группа: —" />

                        <TextView
                            android:id="@+id/student_course"
                            style="@style/TextAppearance.Chuc.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Курс" />

                        <TextView
                            android:id="@+id/student_faculty"
                            style="@style/TextAppearance.Chuc.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_secondary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_grade_book_button"
                        style="@style/Widget.Chuc.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Зачетная книжка" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/open_journal_button"
                        style="@style/Widget.Chuc.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Журнал успеваемости" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/theme_toggle_button"
                        style="@style/Widget.Chuc.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Переключить тему" />

                    <!-- Переключатель формата расписания -->
                    <TextView
                        android:id="@+id/schedule_view_label"
                        style="@style/TextAppearance.Chuc.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Формат расписания"
                        android:textColor="@color/text_secondary" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/schedule_view_toggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/schedule_view_list_button"
                            style="@style/Widget.Chuc.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Списочный" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/schedule_view_calendar_button"
                            style="@style/Widget.Chuc.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Календарный" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/logout_button"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/chip_error_bg"
                        android:text="Выйти"
                        android:textAllCaps="false"
                        android:textColor="@color/chip_error_text"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Небольшой малозаметный текст с версией приложения -->
            <TextView
                android:id="@+id/app_version_text"
                style="@style/TextAppearance.Chuc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/app_version_label"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
