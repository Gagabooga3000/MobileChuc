<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Настройки парсера"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="24dp" />

        <!-- Тип парсера -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тип парсера"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/parser_type_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/radio_auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Автоматический (рекомендуется)"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <RadioButton
                android:id="@+id/radio_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Нативный Android парсер"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <RadioButton
                android:id="@+id/radio_python"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Python парсер"
                android:textColor="@color/text_primary" />

        </RadioGroup>

        <!-- Python сервер -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Python сервер"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Включить Python сервер"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <Switch
                android:id="@+id/python_server_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Информация -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Информация"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Автоматический режим: использует Python парсер, если доступен, иначе нативный\n• Нативный парсер: встроенный Android парсер\n• Python парсер: внешний сервер на Python\n• Для работы Python парсера необходимо запустить сервер на localhost:5000"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Кнопки действий -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <Button
                android:id="@+id/btn_use_python"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Использовать Python парсер (без авторизации)"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/brand_secondary"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_check_python"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Проверить Python"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/brand_primary"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btn_update_python"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Обновить данные"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/brand_primary"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
