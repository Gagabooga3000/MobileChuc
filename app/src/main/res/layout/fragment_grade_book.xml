<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:padding="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_eye"
            android:layout_marginEnd="12dp"
            app:tint="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Зачетная книжка"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/subject_filter_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Предмет"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/subject_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Карточка зачетной книжки -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/bg_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Прогресс бар для загрузки -->
                <ProgressBar
                    android:id="@+id/grade_book_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone" />

                <!-- Текст ошибки -->
                <TextView
                    android:id="@+id/grade_book_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ошибка загрузки"
                    android:textColor="@color/text_error"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Сводка -->
                <LinearLayout
                    android:id="@+id/grade_book_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <!-- Средний балл и прогноз -->
                    <TextView
                        android:id="@+id/average_grade_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/forecast_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone" />

                    <!-- Не сдано -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@color/chip_error_text"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/not_passed_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="не сдано(а) 0 дисциплин(a)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                    <!-- Сдано -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@color/chip_success_text"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/passed_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="сдано(а) 0 дисциплин(a)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Заголовок таблицы -->
                <LinearLayout
                    android:id="@+id/grade_book_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/bg_card_alt"
                    android:padding="8dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="9dp"
                        android:text="№ п/п"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.5"
                        android:layout_marginLeft="1dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="9dp"
                        android:text="Дисциплина"
                        android:textColor="@color/text_primary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="none"
                        android:singleLine="true" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginRight="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="1-1"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="1-2"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="2-3"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="2-4"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="3-5"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:text="3-6"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:paddingEnd="5dp"
                        android:text="4-7"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginLeft="1dp"
                        android:gravity="center"
                        android:paddingStart="0dp"
                        android:text="4-8"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- RecyclerView для записей (вне карточки для лучшей прокрутки) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grade_book_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>

