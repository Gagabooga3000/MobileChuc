<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_background_height"
        android:background="@drawable/header_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="@dimen/header_section_top_padding"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/header_card_top_margin"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/bg_secondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:minHeight="@dimen/header_card_min_height"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/home_header_title"
                    style="@style/TextAppearance.Chuc.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Лента событий"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/home_header_subtitle"
                    style="@style/TextAppearance.Chuc.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Будьте в курсе последних новостей."
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_refresh_button"
                    style="@style/Widget.Chuc.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Обновить" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/home_swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/news_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
                android:paddingBottom="8dp"
                android:clipToPadding="false"
                android:layoutAnimation="@anim/layout_fade_in" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
