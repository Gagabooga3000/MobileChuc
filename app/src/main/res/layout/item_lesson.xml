<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/bg_card_alt">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lesson_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/time_background_modern"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="09:00"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lesson_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/type_background_modern"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Лекция"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/lesson_subject"
            style="@style/TextAppearance.Chuc.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Предмет" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lesson_teacher"
                style="@style/TextAppearance.Chuc.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Преподаватель" />

            <TextView
                android:id="@+id/lesson_group"
                style="@style/TextAppearance.Chuc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Группа"
                android:textColor="@color/brand_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/lesson_place"
            style="@style/TextAppearance.Chuc.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Аудитория" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
