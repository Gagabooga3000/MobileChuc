<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_background_height"
        android:background="@drawable/header_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:paddingTop="@dimen/header_section_top_padding"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/header_card_top_margin"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/bg_secondary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/header_card_min_height"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_background"
                    android:padding="8dp"
                    android:src="@drawable/ic_schedule"
                    app:tint="@color/brand_primary" />

                <TextView
                    android:id="@+id/header_title"
                    style="@style/TextAppearance.Chuc.Title"
                    android:layout_width="0dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="16dp"
                    android:layout_weight="20"
                    android:text="Расписание" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/bg_secondary">

            <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
                android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="@color/text_muted" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/search_group_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
            android:layout_weight="1"
                    android:background="@android:color/transparent"
            android:hint="Поиск группы..."
                    android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />
    </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/groups_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/groups_error"
            style="@style/TextAppearance.Chuc.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:gravity="center"
        android:text="Ошибка загрузки"
        android:textColor="@color/text_error"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_groups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
            android:clipToPadding="false"
        android:paddingBottom="8dp"
            android:layoutAnimation="@anim/layout_fade_in" />

    <LinearLayout
        android:id="@+id/schedule_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/week_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/prev_week"
                    style="@style/TextAppearance.Chuc.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                android:text="‹ Пред."
                    android:textColor="@color/brand_primary" />

            <View
                android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@color/divider_dark" />

            <TextView
                android:id="@+id/next_week"
                    style="@style/TextAppearance.Chuc.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_input_dark"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                android:text="След. ›"
                    android:textColor="@color/brand_primary" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/brand_primary">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/day_tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:tabMode="fixed"
                app:tabGravity="fill"
                app:tabIndicatorHeight="0dp" />
        </com.google.android.material.card.MaterialCardView>

        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_text"
                style="@style/TextAppearance.Chuc.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:gravity="center"
            android:text="Ошибка загрузки"
            android:textColor="@color/text_error"
            android:visibility="gone" />

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/schedule_swipe_refresh"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_schedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    android:layoutAnimation="@anim/layout_fade_in" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/back_button"
            style="@style/TextAppearance.Chuc.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/bg_input_dark"
            android:padding="14dp"
        android:text="← Назад к списку групп"
        android:textColor="@color/brand_primary"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
