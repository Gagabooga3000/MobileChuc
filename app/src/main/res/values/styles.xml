<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ShapeAppearanceOverlay.App.CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TextAppearance.Chuc.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Chuc.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:lineHeight">22sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Chuc.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Chuc.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.Chuc.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_inverse</item>
    </style>

    <style name="Widget.Chuc.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand_secondary</item>
        <item name="strokeColor">@color/brand_secondary</item>
    </style>

</resources>
